{
  "name": "atlas-pessoal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "devDependencies": {
    "@electric-sql/pglite": "0.5.9",
    "@playwright/test": "^1.48.0",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2"
  },
  "scripts": {
    "dev": "python3 -m http.server 8000 --bind 127.0.0.1",
    "build": "node tools/build-app.mjs",
    "desktop:prepare": "node tools/build-desktop.mjs",
    "desktop:start": "npm run desktop:prepare && npm --prefix desktop start",
    "desktop:mac": "npm run desktop:prepare && npm --prefix desktop run dist:mac",
    "test:desktop": "playwright test --config desktop/playwright.config.mjs",
    "test": "playwright test",
    "test:premium-db": "node tests/premium.database.mjs",
    "test:sharing-db": "node tests/trip-sharing.database.mjs",
    "vendor": "node tools/vendor.mjs"
  }
}
